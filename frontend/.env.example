# HaritAyan Frontend Environment Variables Template
VITE_API_BASE_URL="http://localhost:5000/api"
VITE_DEFAULT_LANGUAGE="en"

# Optional: Mapbox Public Access Token (for Mapbox street & satellite layers)
# 1. Sign up at https://account.mapbox.com/
# 2. Copy your default public token (starts with pk.eyJ...)
# 3. Paste below. If blank, CartoDB Voyager tiles will be used automatically.
VITE_MAPBOX_TOKEN="pk.your_mapbox_public_token_here"
