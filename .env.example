# HaritAyan - Environment Configuration Template

# Frontend
VITE_APP_NAME="HaritAyan"
VITE_API_BASE_URL="http://localhost:5000/api"
VITE_DEFAULT_LANGUAGE="en"

# Backend Server
PORT=5000
NODE_ENV=development
CLIENT_URL="http://localhost:5173"

# MongoDB Database
MONGODB_URI="mongodb://localhost:27017/haritayan"

# Authentication
JWT_SECRET="your_jwt_super_secret_key_change_in_production"
JWT_EXPIRE="7d"

# Gemini Multimodal AI
GEMINI_API_KEY="your_gemini_api_key_here"
GEMINI_MODEL="gemini-1.5-flash"

# Weather & Environmental Telemetry
OPENWEATHER_API_KEY="your_openweather_api_key_here"
VADODARA_LAT=22.3072
VADODARA_LON=73.1812

# APMC Mandi Data Source
DATA_GOV_IN_API_KEY="your_data_gov_in_api_key_here"