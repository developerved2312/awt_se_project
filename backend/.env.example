# HaritAyan Backend Environment Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL="http://localhost:5173"

# MongoDB Atlas Database URI
# Replace <username>, <password>, and cluster domain with your MongoDB Atlas details
MONGODB_URI="mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/haritayan_db?retryWrites=true&w=majority"
